# Containerfile para o Frontend (Multi-stage) - Dashboard Hydra

# Estágio 1: Build
FROM node:20-alpine AS builder
WORKDIR /app

# Argumento para a URL da API (passado no build ou env)
ARG VITE_API_URL=https://api.aguasvivas.eco.br
ENV VITE_API_URL=$VITE_API_URL

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

# Estágio 2: Serve com Nginx
FROM nginx:alpine

# Copia o build do estágio anterior
COPY --from=builder /app/dist /usr/share/nginx/html

# Configuração customizada do Nginx para Single Page Application (SPA)
RUN echo 'server { \
    listen 80; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
